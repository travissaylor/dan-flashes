# Server-only Supabase configuration. Find these in Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional, reserved for trusted maintenance jobs. Never prefix this with VITE_ or PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
